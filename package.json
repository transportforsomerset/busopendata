{
  "name": "transport-for-somerset-bus-data",
  "version": "0.8.0",
  "description": "Bus data collector for Transport for Somerset",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "check:types": "bun check",
    "check:fetch": "bun run --parallel bods flix megabus",
    "container": "bun run scripts/container.ts",
    "bods-api": "bun run scripts/fetch-bods-api.ts --debug",
    "bods-zip": "bun run scripts/BODS-zip.ts",
    "flix": "bun run scripts/fetch-flix.ts --debug",
    "megabus": "bun run scripts/fetch-megabus.ts --debug",
    "stops": "bun run scripts/stops.ts",
    "test:bods-repeated": "bun run scripts/test-bods-repeated.ts"
  },
  "contributors": [
    "Transport for Somerset"
  ],
  "devDependencies": {
    "@types/bun": "1.4.3"
  },
  "engines": {
    "bun": "1.4.3"
  }
}
