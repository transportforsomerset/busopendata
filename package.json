{
  "name": "transport-for-somerset-bus-data",
  "version": "0.2.0",
  "description": "Bus data collector Transport for Somerset",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "fresh": "bun run scripts/container.ts",
    "bods": "bun run scripts/fetch-bods.ts --debug",
    "flix": "bun run scripts/fetch-flix.ts",
    "megabus": "bun run scripts/fetch-megabus-new.ts --debug",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "typescript": "7.0.2"
  }
}
