{
  "name": "transport-for-somerset-bus-data",
  "version": "0.2.0",
  "description": "Bus data collector Transport for Somerset",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:fetch": "bun run --parallel bods flix megabus",
    "container": "bun run scripts/container.ts",
    "bods": "bun run scripts/fetch-bods-new.ts --debug",
    "flix": "bun run scripts/fetch-flix.ts --debug",
    "megabus": "bun run scripts/fetch-megabus.ts --debug"
  },
  "contributors": [
    "Transport for Somerset"
  ],
  "devDependencies": {
    "@types/bun": "1.4.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  }
}
